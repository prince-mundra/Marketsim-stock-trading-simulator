{
  "name": "stocksim",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "NODE_ENV=development node --env-file-if-exists=.env server/server.js",
    "build": "vite build",
    "start": "NODE_ENV=production node --env-file-if-exists=.env server/server.js",
    "test": "node --test server/tests/*.test.js",
    "check": "node --check server/server.js && node --check server/app.js && node --check server/services/tradingService.js && node --check server/services/stockPriceService.js"
  },
  "dependencies": {
    "axios": "1.7.9",
    "bcryptjs": "2.4.3",
    "compression": "^1.8.2",
    "cookie-parser": "1.4.7",
    "express": "4.21.2",
    "jsonwebtoken": "9.0.2",
    "lucide-react": "0.468.0",
    "mongoose": "8.9.5",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.28.2",
    "recharts": "2.15.1",
    "socket.io": "4.8.1",
    "socket.io-client": "4.8.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "4.3.4",
    "autoprefixer": "10.4.20",
    "mongodb-memory-server": "10.1.4",
    "postcss": "8.5.1",
    "supertest": "7.0.0",
    "tailwindcss": "3.4.17",
    "vite": "6.1.0"
  }
}
